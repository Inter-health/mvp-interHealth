# Copie este arquivo para .env e preencha com as credenciais reais
# Nunca commite o .env com valores reais

SUPABASE_URL=https://<seu-projeto>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key-do-supabase>
TRANSCRIPT_ENCRYPTION_KEY=<chave-fernet-base64-32-bytes>
JWT_SECRET=<string-aleatoria-minimo-32-chars>
CORS_ORIGINS=http://localhost:3000
HUGGINGFACE_TOKEN=<seu-token-huggingface>
# Transcrição: "assemblyai" (cloud, diarização real), "mock" (sem API key), "large-v3-turbo" (produção WhisperX)
WHISPER_MODEL=assemblyai
ASSEMBLYAI_API_KEY=<sua-chave-assemblyai>

# LLM — geração de SOAP e sugestão de exames (Google Gemini 2.5 Flash)
GEMINI_API_KEY=<sua-chave-google-ai-studio>

# E-mail (Resend) — notificação de demo requests para o time comercial
RESEND_API_KEY=<sua-chave-resend>
EMAIL_FROM=InterHealth <noreply@interhealth.com.br>
SALES_EMAIL=comercial@interhealth.com.br
