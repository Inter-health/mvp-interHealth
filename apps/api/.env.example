# Copie este arquivo para .env e preencha com as credenciais reais
# Nunca commite o .env com valores reais

SUPABASE_URL=https://<seu-projeto>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key-do-supabase>
TRANSCRIPT_ENCRYPTION_KEY=<chave-fernet-base64-32-bytes>
JWT_SECRET=<string-aleatoria-minimo-32-chars>
CORS_ORIGINS=http://localhost:3000
HUGGINGFACE_TOKEN=<seu-token-huggingface>
